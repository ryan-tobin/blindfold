# Copy to .env and fill in. Never commit .env.
# Local mode needs none of these: leave the keys blank.

# NEAR network for the contract: testnet or mainnet
NEAR_NETWORK=testnet
# Account the Blindfold contract is deployed to (Day 5), e.g. blindfold.you.testnet
CONTRACT_ID=
# USDC token contract (NEP-141). Circle's testnet USDC on NEAR is below;
# mainnet is 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af

# NEAR AI Cloud private inference. Blank = use the offline planner stub
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# Optional: your own NEAR RPC. Blank = FastNEAR's public RPC for NEAR_NETWORK
NEAR_RPC_URL=

# dstack simulator for the simulated enclave. docker compose sets it for you;
# blank with `make serve` = dev mode (a local key, no quote)
DSTACK_SIMULATOR_ENDPOINT=

# The encrypted data bundle (make bundle). Blank = read data/riverside.duckdb.
# In Docker: /app/data/riverside.bundle. The real enclave's is in docker-compose.tee.yml
BUNDLE_URL=
# The bundle's SHA-256. Only needed without a contract: with one, the on-chain bundle_hash is used
BUNDLE_HASH=

# Optional NEAR Intents 1Click key (JWT). Without it the fee is 0.2%
ONECLICK_API_KEY=