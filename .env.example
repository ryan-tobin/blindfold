# Copy to .env and fill in.

# Near network for contract: testnet or mainnet
NEAR_NETWORK=testnet
# Account the Blindfold contract is deployed to
CONTRACT_ID=
# USDC token contract (NEP=141) on the chosen network
USDC_CONTRACT=

# Near AI Cloud private inference.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# Local only
DSTACK_SIMULATOR_ENDPOINT=

# Where the enclave fetches the encrypted data bundle
BUNDLE_URL=

# Optional NEAR Intents 1Click JWT
ONECLICK_API_KEY=